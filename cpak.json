{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "Rust SDK",
  "description": "Rust compiler, Cargo, rustfmt and rustup.",
  "version": "1.95.0",
  "image": "ghcr.io/containerpak/sdk-rust@sha256:d519896214f862aca30a49c397a685effe279662f1ce28f205d74ed0989d9e3d",
  "binaries": [
    "/usr/local/bin/rustc",
    "/usr/local/bin/cargo",
    "/usr/local/bin/rustdoc",
    "/usr/local/bin/rustfmt",
    "/usr/local/bin/rustup"
  ],
  "desktop_entries": [],
  "dependencies": [],
  "addons": [],
  "addon_provider": {
    "id": "rust",
    "slot": "sdk.rust",
    "mode": "exclusive",
    "exports": {
      "path": [
        "/opt/cargo/bin"
      ],
      "environment": [
        "RUSTUP_HOME=/opt/rustup",
        "CARGO_HOME=/opt/cargo"
      ]
    }
  },
  "idle_time": 0,
  "override": {
    "displayX11": false,
    "socketWayland": false,
    "socketPulseAudio": false,
    "socketSshAgent": true,
    "socketCups": false,
    "socketGpgAgent": true,
    "bluetooth": false,
    "deviceDri": false,
    "deviceKvm": false,
    "deviceShm": false,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceSerial": false,
    "deviceInput": false,
    "deviceTTY": false,
    "deviceAll": false,
    "notification": false,
    "openURI": false,
    "hostApplications": false,
    "filesystem": [
      {
        "path": "home",
        "access": "read-write"
      }
    ],
    "env": [],
    "network": true,
    "hostNetwork": true,
    "process": false,
    "userNamespaces": false,
    "memoryMaxMB": 0,
    "cpuQuota": 0,
    "pidsMax": 0,
    "asRoot": false
  }
}
